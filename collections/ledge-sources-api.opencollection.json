{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ledge Sources API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://goledge.us.auth0.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.goledge.io/v1/api/:orgId/sources",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization ID, can be found on the Developers page (https://app.goledge.io/developers)."
              }
            ]
          },
          "docs": "Retrieve the list of Sources, including information on fetching times, files fetched, and any issues with fetching or parsing the data."
        }
      ]
    }
  ],
  "bundled": true
}