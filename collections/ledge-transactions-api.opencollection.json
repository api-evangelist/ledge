{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ledge Sources Transactions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://goledge.us.auth0.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query transactions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.goledge.io/v1/api/:orgId/transactions",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization ID, can be found on the Developers page (https://app.goledge.io/developers)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve the list of Transactions, their matches, and their reconciliation status. Filters are expressed as an array of composable typed SearchQuery objects combined with an AND operator."
        }
      ]
    }
  ],
  "bundled": true
}